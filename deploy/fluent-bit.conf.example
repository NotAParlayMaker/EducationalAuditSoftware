# Review with the independently operated collector. Supply SIEM credentials through
# that collector's protected environment, never the Schooldesk application environment.
[SERVICE]
    Parsers_File /etc/fluent-bit/schooldesk-json-parser.conf
    Flush 5
    Log_Level warn
    storage.path /var/lib/fluent-bit/schooldesk-buffer
[INPUT]
    Name tail
    Path /var/lib/schooldesk/security-feed/events-*.jsonl
    Parser schooldesk_security_json
    DB /var/lib/fluent-bit/schooldesk-tail.db
    Read_from_Head true
    storage.type filesystem
[OUTPUT]
    Name http
    Match *
    Host collector.example.invalid
    Port 443
    URI /schooldesk/events
    Format json_lines
    TLS On
    TLS.Verify On
    Header Authorization Bearer ${SCHOOL_SIEM_TOKEN}
    Retry_Limit False
    storage.total_limit_size 256M
