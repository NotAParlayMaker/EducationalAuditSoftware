# Owned root:schooldesk-backup, 0640. Request service must not receive this file.
SCHOOL_DB=/var/lib/schooldesk/school.db
SCHOOL_PROFILE=cloud
SCHOOL_EVENT_KEY_FILE=/etc/schooldesk/verification-secrets/event-key
SCHOOL_CHECKPOINT_DIR=/var/lib/schooldesk-backup-status/checkpoints
SCHOOL_BACKUP_KEY_FILE=/etc/schooldesk/backup-secrets/backup-key
SCHOOL_BACKUP_DIR=/var/lib/schooldesk-backups
SCHOOL_BACKUP_STATUS_FILE=/var/lib/schooldesk-backup-status/last-success.json
