# Values are examples. Store the real file outside git with restrictive ownership.
SCHOOL_PROFILE=cloud
SCHOOL_EVENT_KEY_FILE=/etc/schooldesk/app-secrets/event-key
# Set only after independently verifying live DB, swap, and temporary storage encryption.
SCHOOL_ENCRYPTED_STORAGE_ACK=0
SCHOOL_DB=/var/lib/schooldesk/school.db
SCHOOL_PUBLIC_ORIGIN=https://schooldesk.example.invalid
SCHOOL_PROXY_TOKEN_FILE=/etc/schooldesk/app-secrets/proxy-token
SCHOOL_MFA_KEY_FILE=/etc/schooldesk/app-secrets/mfa-key
SCHOOL_EVIDENCE_SCAN=clamd
SCHOOL_CLAMD_SOCKET=/run/clamav/clamd.ctl
SCHOOL_BACKUP_STATUS_FILE=/var/lib/schooldesk-backup-status/last-success.json
SCHOOL_AI_MODE=offline
# Cloud profile rejects external AI. Use only offline drafting with school records.
